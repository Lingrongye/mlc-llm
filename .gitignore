# ===========================================
# MLC-LLM .gitignore (Qwen3-VL 分支专用)
# 删除了会影响源码的规则: debug/, target/, lib/
# ===========================================

# ===== 编译输出 =====
build/
build-*/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
.eggs/
*.whl

# ===== 虚拟环境 =====
venv/
.venv/
env/
ENV/
.conda/

# ===== IDE 和编辑器 =====
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.iml

# ===== 系统文件 =====
.DS_Store
Thumbs.db
.nfs*

# ===== 日志和临时文件 =====
*.log
tmp/
*.tmp
*.bak

# ===== 测试和覆盖率 =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ===== 其他 =====
.env
.python-version
*.params
*.onnx
.mypy_cache/

# ===== JVM/Java 相关 =====
jvm/*/target/
jvm/*/*/target/
jvm/target
*.class

# ===== 生成的文件 =====
src/runtime/hexagon/rpc/hexagon_rpc.h
src/runtime/hexagon/rpc/hexagon_rpc_skel.c
src/runtime/hexagon/rpc/hexagon_rpc_stub.c
